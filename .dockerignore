# deps & build output — rebuilt inside the image
node_modules
.next
out

# secrets & local env — runtime env comes from compose/k8s, never the image
.env
.env.*
!.env.example

# VCS / tooling
.git
.github
.claude
.vscode

# logs & session capture (Internal classification — must not enter images)
logs

# mutable runtime state — fresh containers must fall back to env defaults
data/llm-config.json

# tests & local artifacts
tests
playwright-report
test-results
coverage
*.log

# docs & misc not needed at runtime
docs
infra
scripts
README.md
