{
  "name": "country-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Country Intelligence Platform for UAE government leadership",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval-rag.ts",
    "seed:rag": "tsx scripts/seed-rag-corpus.ts",
    "fetch:corpus": "tsx scripts/fetch-real-corpus.ts",
    "seed:build": "tsx scripts/build-seed.ts",
    "warm": "bash scripts/warm.sh",
    "log:trace": "tsx scripts/log-trace.ts",
    "db:up": "docker compose up -d postgres redis opensearch",
    "db:migrate": "for f in db/migrations/*.sql; do echo \"applying $f\"; psql \"$DATABASE_URL\" -f \"$f\" || exit 1; done",
    "db:seed": "bash scripts/seed.db.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@antv/infographic": "0.2.19",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/ollama": "^1.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/otel": "^2.1.2",
    "clsx": "^2.1.1",
    "mammoth": "^1.12.0",
    "motion": "^12.40.0",
    "next": "^15.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp", "@napi-rs/canvas"]
  }
}
