# --- Node / Next ---
LOG_LEVEL=info

# --- DB ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/country_intel
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200

# --- Auth (UAE PASS / Entra OIDC) ---
JWT_SECRET=replace-me-32-chars-min
OIDC_ISSUER=https://login.example.ae
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# --- AI / LLM provider ---
# SOVEREIGN-AI: this platform runs on LOCAL Ollama only. Keep these two gates on;
# cloud providers (Anthropic/OpenRouter/OpenAI/Voyage/Cohere) are forbidden at runtime.
LLM_PROVIDER=openrouter
OFFLINE_MODE=false

# Anthropic direct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# OpenRouter (OpenAI-compatible aggregator)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_REFERER=https://country-intel.local
OPENROUTER_APP_NAME=Country Intelligence Platform
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override if proxying

# Local on-prem LLM (Ollama). Models live on the workspace SSD — point Ollama there
# via: ln -s /Volumes/Workspace/ollama-models ~/.ollama/models  (see AGENTS.md / CLAUDE.md).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b          # fallback baseline (rarely hit)
OLLAMA_MODEL_LIGHT=qwen2.5:3b     # router / scope parsing
OLLAMA_MODEL_HEAVY=qwen2.5:7b     # analyst, opportunity scoring
OLLAMA_MODEL_TOOLS=qwen2.5:7b     # LangGraph tool-loop (qwen tool-calls; gemma cannot)
OLLAMA_MODEL_SCRIBE=gemma4:12b    # EN/AR brief prose (best Arabic; ~9 tok/s, slow)
OLLAMA_KEEP_ALIVE=30m             # keep models resident between requests

# RAG abstention thresholds (lower → more answers, less abstain).
# 0.35 / 0.60 = production defaults (real embeddings).
# Lower to 0.05 / 0.30 when running on mock embeddings.
RAG_MIN_TOP_SCORE=0.35
RAG_MIN_ENTITY_COVERAGE=0.60

# RAG embedders (local only at runtime — nomic-embed-text must be pulled)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multilingual-2
OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG reranker
COHERE_API_KEY=
COHERE_MODEL=rerank-multilingual-v3.0
LOCAL_RERANK_URL=

# RAG: per-step model overrides (optional)
UNDERSTAND_MODEL_ANTHROPIC=claude-haiku-4-5
UNDERSTAND_MODEL_OPENROUTER=
UNDERSTAND_MODEL_LOCAL=

# Logging
# Set to "true" to forward every request to logs/access.jsonl via internal route.
# Default: false (console.log only — host log aggregator collects).
ACCESS_LOG_FORWARD=false

# Security anomaly detector
SECURITY_ANOMALY_WINDOW_MS=300000
SECURITY_ANOMALY_THRESHOLD=5
SECURITY_ANOMALY_COOLDOWN_MS=600000

# LLM cost budget caps (USD, daily).
# Set to 0 (default) to disable. Crossing fires one audit event
# `cost.budget.exceeded` per scope per UTC day.
DAILY_BUDGET_USD=0
PER_USER_DAILY_BUDGET_USD=0
# Set to "true" for hard 429 enforcement (default false = alert-only)
BUDGET_ENFORCE_BLOCK=false

# Log rotation (pnpm log:rotate)
LOG_ROTATE_BYTES=10485760
LOG_RETAIN_FILES=7
LOG_TARGET_DIR=logs

# --- Live data sources (the /agent pipeline fetches these at request time) ---
WORLDBANK_API_BASE=https://api.worldbank.org/v2   # World Bank — no key
# IMF DataMapper + UN Comtrade preview need no key. EIA substitutes for IEA (no free IEA API).
EIA_API_KEY=          # free: www.eia.gov/developer  (oil production/consumption)
TAVILY_API_KEY=       # tavily.com  (live web research + news)
COMTRADE_KEY=         # optional — UN Comtrade authed endpoint (preview works keyless)
AGENT_AIRGAP=0        # 1 = offline mode: cache/seed only, no live API calls (sovereign)
IEA_API_KEY=          # unused (IEA has no free API); kept for reference
WEF_API_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- SIEM forwarding (audit log) ---
# Transport: "syslog-tcp" | "syslog-tls" | "http" | "none" (default none → audit stays local jsonl only)
SIEM_TRANSPORT=none
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=6514
SIEM_HTTP_URL=
SIEM_HTTP_TOKEN=
SIEM_APP_NAME=country-intel

# --- Storage ---
S3_ENDPOINT=
S3_BUCKET=country-intel-docs
S3_REGION=me-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# --- On-prem speech-to-text (TODO-032 / data residency) ---
# OpenAI-compatible transcription server (speaches, faster-whisper-server,
# whisper.cpp). When set, voice input uses it instead of the browser's
# cloud-backed engine. Local stack: docker compose --profile voice up -d
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
COMTRADE_KEY=       # optional; UN Comtrade authed endpoint (higher limits)
